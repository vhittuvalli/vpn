# systemd unit for running the VPN server. `sudo vpn setup` installs it for
# you; to do it by hand:
#
#   sudo cp vpn.service /etc/systemd/system/
#   sudo mkdir -p /etc/vpn && sudo cp server.json /etc/vpn/
#   sudo systemctl enable --now vpn
[Unit]
Description=vpn server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/vpn server -c /etc/vpn/server.json
# `vpn invite` and `vpn revoke` reload the device list this way.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
# Signal only the server on stop, so the iptables commands it runs while
# cleaning up aren't killed halfway and leave stale rules behind.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
